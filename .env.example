# Copy this file to .env and fill in your API keys

# OpenAI API Key
OPEN_API_KEY=""

# Fal AI API Key (for image generation with Flux Schnell)
FAL_API_KEY=""

# ElevenLabs API Key (for voice generation)
ELVEN_LABS_API_KEY=""

# 60db API Key (alternative voice generation provider)
DB60_API_KEY=""

# Which TTS provider to use: "elevenlabs" (default) or "60db"
TTS_PROVIDER="elevenlabs"